{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/platform/helm-release.schema.json",
  "title": "Generated values of one Helm release (Terraform outputs + registry -> Helm)",
  "description": "Contract between Stage 5 (Terraform) and Stage 6 (Helm). Generated by tools/iac/helmvalues.py; in the pipeline the same fields are read from `terraform output -json`. x-source names the producer of every field; tests check that each Terraform output exists.",
  "type": "object",
  "additionalProperties": false,
  "required": ["tenant", "product", "env", "image", "serviceAccount", "route", "database", "secrets", "buckets", "config", "isolation"],
  "properties": {
    "tenant": { "type": "string", "pattern": "^([a-z][a-z0-9]{2,9}|multi)$", "x-source": "registry:tenants/<tenant>.yaml tenant" },
    "product": { "type": "string", "pattern": "^[a-z][a-z0-9]{1,10}$", "x-source": "registry:products/<product>.yaml product" },
    "env": { "enum": ["dev", "stg", "uat", "prd"], "x-source": "registry:subscription versions key" },
    "image": {
      "type": "object", "additionalProperties": false, "required": ["repository", "digest", "version"],
      "properties": {
        "repository": { "type": "string", "pattern": "^[a-z0-9-]+-docker\\.pkg\\.dev/shr-artifacts/(release|snapshot)/", "x-source": "terraform:org.output.artifact_registry" },
        "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$", "x-source": "pipeline:Artifact Registry tag -> digest of image.version" },
        "version": { "type": "string", "x-source": "registry:subscription versions[env] (Shared: product version; Cohort: cohort version)" }
      }
    },
    "serviceAccount": {
      "type": "object", "additionalProperties": false, "required": ["name", "migrationName"],
      "properties": {
        "name": { "type": "string", "x-source": "terraform:cluster-config.output.namespaces (KSA from D8 baseline)" },
        "migrationName": { "type": "string", "x-source": "terraform:cluster-config.output.namespaces (KSA from D8 baseline)" }
      }
    },
    "route": {
      "type": "object", "additionalProperties": false, "required": ["gateway", "hostnames"],
      "properties": {
        "gateway": {
          "type": "object", "additionalProperties": false, "required": ["name", "namespace"],
          "properties": {
            "name": { "type": "string", "pattern": "^gw-", "x-source": "terraform:cluster-config.output.gateways" },
            "namespace": { "const": "gateway-infra", "x-source": "terraform:cluster-config.output.gateways" }
          }
        },
        "hostnames": { "type": "array", "minItems": 1, "items": { "type": "string" }, "x-source": "registry:hostname convention (N4 records)" }
      }
    },
    "database": {
      "type": "object", "additionalProperties": false, "required": ["enabled", "instanceConnectionName", "name", "user", "migrationUser"],
      "properties": {
        "enabled": { "type": "boolean", "x-source": "registry:products/<product>.yaml database" },
        "instanceConnectionName": { "type": "string", "pattern": "^[a-z][a-z0-9-]+:[a-z0-9-]+:[a-z0-9-]+$", "x-source": "terraform:platform.output.sql_connection_names" },
        "name": { "type": "string", "pattern": "^[a-z][a-z0-9]{2,9}_[a-z][a-z0-9]{1,10}$", "x-source": "registry:<tenant>_<product> (D4)" },
        "user": { "type": "string", "maxLength": 32, "x-source": "terraform:tenant.output.sql_users" },
        "migrationUser": { "type": "string", "maxLength": 32, "x-source": "terraform:tenant.output.sql_users" }
      }
    },
    "secrets": { "type": "object", "additionalProperties": { "type": "string", "pattern": "^projects/[a-z0-9-]+/secrets/[a-z0-9-]+$" }, "x-source": "terraform:tenant.output.secret_ids" },
    "buckets": { "type": "object", "additionalProperties": { "type": "string" }, "x-source": "terraform:tenant.output.bucket_names" },
    "config": { "type": "object", "additionalProperties": { "type": ["string", "number", "boolean"] }, "x-source": "registry:subscription config" },
    "isolation": {
      "type": "object", "additionalProperties": false, "required": ["dedicatedNodes"],
      "properties": { "dedicatedNodes": { "type": "boolean", "x-source": "registry:tenants/<tenant>.yaml isolation_tier" } }
    }
  }
}
