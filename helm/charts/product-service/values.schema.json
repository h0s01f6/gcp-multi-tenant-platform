{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["customer", "env", "product", "version"],
  "properties": {
    "customer": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,11}$" },
    "env": { "type": "string", "enum": ["dev", "stage", "uat", "prod"] },
    "product": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,24}$" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(-[a-z0-9]+\\.[0-9]+)?$" },
    "replicaCount": { "type": "integer", "minimum": 0 },
    "config": { "type": "object" },
    "featureFlags": { "type": "object" }
  }
}
